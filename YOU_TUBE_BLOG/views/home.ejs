<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("./partials/head") %>
        <title>HomePage</title>
</head>

<body>
    <%- include("./partials/nav") %>

    <%- include("./partials/script") %>

        <div class="container mt-3">
            <% blogs.forEach(blog=> { %>
                <section class="card" style="width: 18rem">
                    <img src="<%= blog.coverImageURL %>" class="card-img-top" alt="Image">
                    <div class="card-body">
                        <h5 class="card-title"><%= blog.title %></h5>
                        
                        <a href="/blog/<%= blog._id %>" class="btn-solid theme-primary">View</a>
                    </div>
                </section>

                <% }) %>
        </div>


        


</body>

</html>